# Copy this file to .env and fill in your values.
# .env is git-ignored and should never be committed.

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development          # set to "production" on Render

# ── Database ─────────────────────────────────────────────────────────────────
# Local dev (docker-compose):
DATABASE_URL=postgresql://psoriasis:psoriasis@localhost:5433/psoriasis
# Render injects this automatically from the managed Postgres instance.

# ── Security ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Never commit the real value.
SECRET_KEY=replace-me-with-a-real-64-char-hex-string

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Wildcards (*) are rejected.
ALLOWED_ORIGINS=http://localhost:8501

# ── Auth ─────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_DAYS=7

# ── Frontend (set on the Streamlit service, not the API) ─────────────────────
API_BASE_URL=http://127.0.0.1:8000

# ── Server (Render injects this; set manually for local overrides) ────────────
PORT=8000
